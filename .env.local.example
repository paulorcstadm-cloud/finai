# FinAI — Environment Variables
# Copy this file to .env.local and fill in your values

# Anthropic API (Claude AI) — get yours at https://console.anthropic.com
# Without this key the chat works with smart pre-built responses
ANTHROPIC_API_KEY=sk-ant-api-xxxxxxxxxxxxxxxxxxxxx

# Supabase (optional — needed for real database)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
