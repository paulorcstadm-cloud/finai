{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "FinAI — Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "FinAI — Production Build",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build"],
      "port": 3000
    },
    {
      "name": "FinAI — Production Start",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000
    }
  ]
}
